# Keep the deploy image lean. Anything not COPY'd by the Dockerfile is
# moot, but excluding the heavy stuff here also speeds up `docker build`'s
# context-transfer step.

# Python tooling output
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage*
htmlcov/

# Virtualenv + IDE state
.venv/
.idea/
.vscode/

# Dev-only artifacts
eval/results/
data/raw/
.git/
.github/

# Local secrets — Spaces injects GROQ_API_KEY via its own secrets UI
.env
.env.local

# Note: README.md is intentionally NOT excluded. Hatchling reads it during
# `uv sync` to validate the project's `readme = "README.md"` declaration
# in pyproject.toml. Excluding it makes the build fail with a confusing
# "Readme file does not exist" OSError.
