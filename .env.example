# ---------------------------------------------------------------------------
# boardgames-rag — local environment secrets
#
# Week 1 (ingestion) does not require any of these. They land later:
#   - GROQ_API_KEY:   free-tier hosted inference. Default Ragas eval judge
#     (week 4) and the agentic loop (week 5). https://console.groq.com/keys
#   - GEMINI_API_KEY: optional alternate Ragas judge — set eval.judge_provider
#     to "gemini" in config.yaml. https://aistudio.google.com/app/apikey
#
# Copy this file to `.env` and fill in values when needed. `.env` is gitignored.
# ---------------------------------------------------------------------------

GEMINI_API_KEY=
GROQ_API_KEY=
